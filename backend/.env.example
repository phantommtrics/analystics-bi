DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bireports?schema=public"
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATASOURCE_ENCRYPTION_KEY="replace-with-base64-32-byte-key"
PORT=4000
CORS_ORIGIN="http://localhost:5173,http://localhost:5174"
APP_PUBLIC_URL="http://localhost:5173"

JWT_ACCESS_SECRET="replace-with-long-random-secret"
JWT_REFRESH_SECRET="replace-with-another-long-random-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

OWNER_USERNAME="phantom"
OWNER_EMAIL="phantom@bi.local"
OWNER_PASSWORD="123456"

APP_PUBLIC_URL="http://localhost:5173"

# Resend (https://resend.com) — invitation emails for new operators
# RESEND_FROM must use a domain verified in your Resend dashboard
RESEND_API_KEY="re_xxxxxxxx"
RESEND_FROM="PrixBI <onboarding@yourdomain.com>"

# Log credentials to the server console when Resend is unreachable (default in development)
MAIL_FALLBACK_CONSOLE="true"

# Report schedule processor: how often to check for due schedules (milliseconds, 5000–86400000)
REPORT_SCHEDULE_POLL_INTERVAL_MS=60000

# DirectPay partner integration (optional)
# DIRECTPAY_API_BASE_URL="http://localhost:4000"
# DIRECTPAY_INTERNAL_PARTNER_API_SECRET=""
# DIRECTPAY_PUBLIC_APP_URL="http://localhost:5173"
# DIRECTPAY_WEBHOOK_SECRET=""

# Subscription reminder emails when billing cycle < 30 days
# Production: daily at 00:00 in SUBSCRIPTION_REMINDER_TIMEZONE
# Test: set SUBSCRIPTION_REMINDER_TEST_MODE=true — first send ~2 min after server start, then every 2 min
SUBSCRIPTION_REMINDER_POLL_INTERVAL_MS=60000
SUBSCRIPTION_REMINDER_TIMEZONE="UTC"
SUBSCRIPTION_REMINDER_TEST_MODE="true"
SUBSCRIPTION_REMINDER_TEST_DELAY_MS=120000

# Partner agent float balance sync
# Per-organization credentials are configured in the Agent Float Sync UI.
# PARTNER_AGENT_FLOAT_PROCESSOR_POLL_MS=60000
