DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bireports?schema=public"
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATASOURCE_ENCRYPTION_KEY="replace-with-base64-32-byte-key"
PORT=4000
CORS_ORIGIN="http://localhost:5173"
APP_PUBLIC_URL="http://localhost:5173"

JWT_ACCESS_SECRET="replace-with-long-random-secret"
JWT_REFRESH_SECRET="replace-with-another-long-random-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

OWNER_USERNAME="phantom"
OWNER_EMAIL="phantom@bi.local"
OWNER_PASSWORD="123456"

APP_PUBLIC_URL="http://localhost:5173"

# Resend (https://resend.com) — invitation emails for new operators
# RESEND_FROM must use a domain verified in your Resend dashboard
RESEND_API_KEY="re_xxxxxxxx"
RESEND_FROM="APS Wallet BI <onboarding@yourdomain.com>"

# Log credentials to the server console when Resend is unreachable (default in development)
MAIL_FALLBACK_CONSOLE="true"

# Report schedule processor: how often to check for due schedules (milliseconds, 5000–86400000)
REPORT_SCHEDULE_POLL_INTERVAL_MS=60000
