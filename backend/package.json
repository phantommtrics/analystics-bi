{
  "name": "bi-reports-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "seed:dashboard-reports": "tsx scripts/seed-dashboard-reports.ts --validate --seed",
    "test": "tsx --test src/partner-agent-float/crypto.test.ts src/datasources/postgres.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "latest",
    "cookie-parser": "latest",
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "jspdf": "^3.0.1",
    "jspdf-autotable": "^5.0.2",
    "jsonwebtoken": "latest",
    "pg": "^8.21.0",
    "resend": "^6.12.4",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/bcryptjs": "latest",
    "@types/cookie-parser": "latest",
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/jsonwebtoken": "latest",
    "@types/node": "latest",
    "@types/pg": "^8.20.0",
    "prisma": "^6.19.3",
    "tsx": "latest",
    "typescript": "latest"
  }
}
