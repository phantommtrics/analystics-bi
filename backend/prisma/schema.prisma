generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  OWNER
  SYSTEM_USER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum TokenStatus {
  ACTIVE
  REVOKED
}

enum DataSourceType {
  POSTGRES
}

enum SslMode {
  DISABLE
  REQUIRE
}

enum ReportCategory {
  FINANCIAL
  OPERATIONAL
  COMPLIANCE
  AGENT
  GENERAL
  AGENTS
  BALANCE
  CUSTOMERS
  BANKS
  REMITTANCE
  AML
  RECONCILIATION
}

enum ReportVisualization {
  BAR_CHART
  LINE_CHART
  PIE_CHART
  TABLE_ONLY
}

enum ReportScheduleStatus {
  ACTIVE
  PAUSED
  COMPLETED
  FAILED
}

enum ReportScheduleRecurrence {
  ONCE
  DAILY
  WEEKLY
  MONTHLY
}

enum StatementType {
  FINANCIAL_PL
  BANK_STATEMENT
  LEDGER_BALANCE
  CUSTOM
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum PartnerAgentFloatDeliveryStatus {
  RUNNING
  SUCCESS
  FAILED
}

model Organization {
  id                      String             @id @default(cuid())
  name                    String
  slug                    String             @unique
  industry                String?
  status                  OrganizationStatus @default(ACTIVE)
  isDefault               Boolean            @default(false)
  billingOwnerEmail       String?
  billingOwnerName        String?
  directPayBusinessId     String?            @unique
  directPaySlug           String?
  directPaySubscriptionId String?
  subscriptionStatus      String?
  subscriptionPeriodEnd   DateTime?
  subscriptionPeriodStart DateTime?
  subscriptionBillingInterval String?
  subscriptionPlanCode    String?
  subscriptionSyncedAt    DateTime?
  subscriptionPayUrl      String?
  subscriptionReminderLastSentAt DateTime?
  users                   User[]
  dataSources             DataSource[]
  userGroups              UserGroup[]
  savedReports            SavedReport[]
  dashboards              Dashboard[]
  statements              Statement[]
  partnerAgentFloat       OrganizationPartnerAgentFloat?
  partnerAgentFloatDeliveries PartnerAgentFloatDelivery[]
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
}

model User {
  id                 String            @id @default(cuid())
  username           String            @unique
  email              String            @unique
  displayName        String?
  passwordHash       String
  userType           UserType
  status             UserStatus        @default(ACTIVE)
  mustChangePassword Boolean           @default(false)
  organizationId     String?
  organization       Organization?     @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  lastLoginAt        DateTime?
  roles              UserRole[]
  groups             UserGroupMember[]
  refreshTokens      RefreshToken[]
  dataSources        DataSource[]
  savedReports       SavedReport[]     @relation("ReportCreatedBy")
  updatedReports     SavedReport[]     @relation("ReportUpdatedBy")
  reportSchedules     ReportSchedule[]     @relation("ScheduleCreatedBy")
  statementSchedules  StatementSchedule[]  @relation("StatementScheduleCreatedBy")
  dashboards         Dashboard[]       @relation("DashboardCreatedBy")
  updatedDashboards  Dashboard[]       @relation("DashboardUpdatedBy")
  statements         Statement[]       @relation("StatementCreatedBy")
  updatedStatements  Statement[]       @relation("StatementUpdatedBy")
  auditLogs          AuditLog[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([organizationId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userLabel String
  action    String
  resource  String?
  ipAddress String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([action])
  @@index([userId])
  @@index([userLabel])
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  users       UserRole[]
  groups      UserGroup[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(cuid())
  moduleKey   String
  actionKey   String
  name        String
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([moduleKey, actionKey])
}

model UserRole {
  userId     String
  roleId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  assignedAt   DateTime   @default(now())

  @@id([roleId, permissionId])
}

model UserGroup {
  id             String            @id @default(cuid())
  name           String
  description    String?
  roleId         String
  organizationId String
  role           Role              @relation(fields: [roleId], references: [id], onDelete: Restrict)
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        UserGroupMember[]
  reportSchedules    ReportSchedule[]
  statementSchedules StatementSchedule[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
}

model UserGroupMember {
  userId     String
  groupId    String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  group      UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  assignedAt DateTime  @default(now())

  @@id([userId, groupId])
}

model RefreshToken {
  id           String      @id @default(cuid())
  userId       String
  tokenHash    String      @unique
  expiresAt    DateTime
  status       TokenStatus @default(ACTIVE)
  replacedById String?
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model DataSource {
  id                String         @id @default(cuid())
  name              String
  type              DataSourceType @default(POSTGRES)
  host              String
  port              Int            @default(5432)
  database          String
  username          String
  passwordEncrypted String
  sslMode           SslMode        @default(REQUIRE)
  isActive          Boolean        @default(true)
  organizationId    String
  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById       String?
  createdBy         User?          @relation(fields: [createdById], references: [id])
  savedReports      SavedReport[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
}

model SavedReport {
  id            String              @id @default(cuid())
  name          String
  description   String?
  category      ReportCategory      @default(GENERAL)
  sql           String              @db.Text
  visualization ReportVisualization @default(BAR_CHART)
  dataSourceId  String
  dataSource    DataSource          @relation(fields: [dataSourceId], references: [id], onDelete: Restrict)
  organizationId String
  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  isPublished        Boolean             @default(false)
  showInSidebarMenu  Boolean             @default(false)
  publishedAt        DateTime?
  createdById   String?
  createdBy     User?               @relation("ReportCreatedBy", fields: [createdById], references: [id])
  updatedById   String?
  updatedBy     User?               @relation("ReportUpdatedBy", fields: [updatedById], references: [id])
  deletedAt     DateTime?
  deletedById   String?
  schedules     ReportSchedule[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([deletedAt])
  @@index([name])
  @@index([category])
  @@index([isPublished])
  @@index([showInSidebarMenu])
  @@index([organizationId])
}

model ReportSchedule {
  id                    String                   @id @default(cuid())
  reportId              String
  report                SavedReport              @relation(fields: [reportId], references: [id], onDelete: Cascade)
  groupId               String
  group                 UserGroup                @relation(fields: [groupId], references: [id], onDelete: Restrict)
  recurrence            ReportScheduleRecurrence @default(ONCE)
  scheduledAt           DateTime
  timeMinutes           Int?
  dayOfWeek             Int?
  dayOfMonth            Int?
  timezoneOffsetMinutes Int                      @default(0)
  status                ReportScheduleStatus     @default(ACTIVE)
  lastSentAt            DateTime?
  lastError             String?                  @db.Text
  createdById           String?
  createdBy             User?                    @relation("ScheduleCreatedBy", fields: [createdById], references: [id])
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@index([status, scheduledAt])
  @@index([reportId])
  @@index([groupId])
}

model Dashboard {
  id                String          @id @default(cuid())
  name              String
  description       String?
  layout            Json
  organizationId    String
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  showInSidebarMenu Boolean         @default(false)
  sidebarCategory   ReportCategory?
  isPublished       Boolean         @default(false)
  publishedAt       DateTime?
  createdById String?
  createdBy   User?     @relation("DashboardCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?     @relation("DashboardUpdatedBy", fields: [updatedById], references: [id])
  deletedAt   DateTime?
  deletedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([deletedAt])
  @@index([name])
  @@index([isPublished])
  @@index([showInSidebarMenu])
  @@index([sidebarCategory])
  @@index([organizationId])
}

model Statement {
  id          String         @id @default(cuid())
  name        String
  description String?
  type        StatementType
  category    ReportCategory @default(GENERAL)
  config      Json
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  isPublished Boolean        @default(false)
  publishedAt DateTime?
  createdById String?
  createdBy   User?          @relation("StatementCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?          @relation("StatementUpdatedBy", fields: [updatedById], references: [id])
  deletedAt   DateTime?
  deletedById String?
  schedules   StatementSchedule[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([deletedAt])
  @@index([name])
  @@index([category])
  @@index([type])
  @@index([isPublished])
  @@index([organizationId])
}

model StatementSchedule {
  id                    String                   @id @default(cuid())
  statementId           String
  statement             Statement                @relation(fields: [statementId], references: [id], onDelete: Cascade)
  groupId               String
  group                 UserGroup                @relation(fields: [groupId], references: [id], onDelete: Restrict)
  recurrence            ReportScheduleRecurrence @default(ONCE)
  scheduledAt           DateTime
  timeMinutes           Int?
  dayOfWeek             Int?
  dayOfMonth            Int?
  timezoneOffsetMinutes Int                      @default(0)
  status                ReportScheduleStatus     @default(ACTIVE)
  lastSentAt            DateTime?
  lastError             String?                  @db.Text
  createdById           String?
  createdBy             User?                    @relation("StatementScheduleCreatedBy", fields: [createdById], references: [id])
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@index([status, scheduledAt])
  @@index([statementId])
  @@index([groupId])
}

model OrganizationPartnerAgentFloat {
  id                     String       @id @default(cuid())
  organizationId         String       @unique
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enabled                Boolean      @default(false)
  apiUrl                 String?
  apiKeyEncrypted        String?
  hmacSecretEncrypted    String?
  encryptionKeyEncrypted String?
  partnerOrgCode         String?
  intervalMs             Int          @default(300000)
  requestTimeoutMs       Int          @default(30000)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
}

model PartnerAgentFloatDelivery {
  id             String                          @id @default(cuid())
  organizationId String
  organization   Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveryId     String                          @unique
  snapshotAt     DateTime
  recordCount    Int
  status         PartnerAgentFloatDeliveryStatus
  httpStatus     Int?
  errorMessage   String?                         @db.Text
  durationMs     Int?
  createdAt      DateTime                        @default(now())

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([status])
}
