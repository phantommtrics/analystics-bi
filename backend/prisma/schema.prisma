generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  OWNER
  SYSTEM_USER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum TokenStatus {
  ACTIVE
  REVOKED
}

enum DataSourceType {
  POSTGRES
}

enum SslMode {
  DISABLE
  REQUIRE
}

enum ReportCategory {
  FINANCIAL
  OPERATIONAL
  COMPLIANCE
  AGENT
  GENERAL
}

enum ReportVisualization {
  BAR_CHART
  LINE_CHART
  PIE_CHART
  TABLE_ONLY
}

model User {
  id                 String            @id @default(cuid())
  username           String            @unique
  email              String            @unique
  displayName        String?
  passwordHash       String
  userType           UserType
  status             UserStatus        @default(ACTIVE)
  mustChangePassword Boolean           @default(false)
  lastLoginAt        DateTime?
  roles              UserRole[]
  groups             UserGroupMember[]
  refreshTokens      RefreshToken[]
  dataSources        DataSource[]
  savedReports       SavedReport[]     @relation("ReportCreatedBy")
  updatedReports     SavedReport[]     @relation("ReportUpdatedBy")
  dashboards         Dashboard[]       @relation("DashboardCreatedBy")
  updatedDashboards  Dashboard[]       @relation("DashboardUpdatedBy")
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  users       UserRole[]
  groups      UserGroup[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(cuid())
  moduleKey   String
  actionKey   String
  name        String
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([moduleKey, actionKey])
}

model UserRole {
  userId     String
  roleId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  assignedAt   DateTime   @default(now())

  @@id([roleId, permissionId])
}

model UserGroup {
  id          String            @id @default(cuid())
  name        String            @unique
  description String?
  roleId      String
  role        Role              @relation(fields: [roleId], references: [id], onDelete: Restrict)
  members     UserGroupMember[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model UserGroupMember {
  userId     String
  groupId    String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  group      UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  assignedAt DateTime  @default(now())

  @@id([userId, groupId])
}

model RefreshToken {
  id           String      @id @default(cuid())
  userId       String
  tokenHash    String      @unique
  expiresAt    DateTime
  status       TokenStatus @default(ACTIVE)
  replacedById String?
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model DataSource {
  id                String         @id @default(cuid())
  name              String         @unique
  type              DataSourceType @default(POSTGRES)
  host              String
  port              Int            @default(5432)
  database          String
  username          String
  passwordEncrypted String
  sslMode           SslMode        @default(REQUIRE)
  isActive          Boolean        @default(true)
  createdById       String?
  createdBy         User?          @relation(fields: [createdById], references: [id])
  savedReports      SavedReport[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model SavedReport {
  id            String              @id @default(cuid())
  name          String
  description   String?
  category      ReportCategory      @default(GENERAL)
  sql           String              @db.Text
  visualization ReportVisualization @default(BAR_CHART)
  dataSourceId  String
  dataSource    DataSource          @relation(fields: [dataSourceId], references: [id], onDelete: Restrict)
  createdById   String?
  createdBy     User?               @relation("ReportCreatedBy", fields: [createdById], references: [id])
  updatedById   String?
  updatedBy     User?               @relation("ReportUpdatedBy", fields: [updatedById], references: [id])
  deletedAt     DateTime?
  deletedById   String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([deletedAt])
  @@index([name])
  @@index([category])
}

model Dashboard {
  id          String    @id @default(cuid())
  name        String
  description String?
  layout      Json
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdById String?
  createdBy   User?     @relation("DashboardCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?     @relation("DashboardUpdatedBy", fields: [updatedById], references: [id])
  deletedAt   DateTime?
  deletedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([deletedAt])
  @@index([name])
  @@index([isPublished])
}
